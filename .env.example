# Environment variables for docker-compose / local runs.
#
# Copy this file to `.env` (git-ignored) and fill in strong values. NEVER commit
# a real secret. The compose file requires the secret variables below and will
# refuse to start ("set VAR in your environment") if any is missing.
#
# Rotation: secrets are injected purely from the environment, so rotating one
# means changing its value here (or in your secrets store) and restarting the
# affected services:  docker compose up -d --force-recreate <service>

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=alejandria
# REQUIRED. Generate a strong value, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
# DATABASE_URL is derived from POSTGRES_PASSWORD inside docker-compose.yml.
# Set it explicitly only for non-compose runs (keep the password out of git):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@postgres:5432/alejandria

# ── Security (JWT) ──────────────────────────────────────────
# REQUIRED in production. Must be a strong random value (>= 32 chars) and must
# NOT contain obvious placeholders (change-in-production, changeme, ...), or the
# backend aborts on startup. Generate with: openssl rand -hex 32
# Rotate by replacing this value and restarting the backend (invalidates tokens).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Access control (secure defaults) ────────────────────────
# Role assigned to users on self-registration. Minimal privilege: lector | publico.
DEFAULT_SIGNUP_ROLE=lector
# Dev-only shortcut to self-promote a role. MUST stay false outside local dev.
ENABLE_DEV_ROLE_PROMOTION=false

# ── Redis ───────────────────────────────────────────────────
# REQUIRED if Redis is enabled. Generate with: openssl rand -hex 24
REDIS_PASSWORD=
# REDIS_URL is derived from REDIS_PASSWORD; override only for non-compose runs:
# REDIS_URL=redis://:<password>@redis:6379/0

# ── LLM provider (motor agéntico) ───────────────────────────
# Motor por defecto: Claude (Anthropic) — SPEC-023 / ADR-0009. Cambia a on-prem
# con LLM_PROVIDER=ollama (modelos locales) o LLM_PROVIDER=openai (servidor
# compatible: vLLM / LM Studio vía OPENAI_BASE_URL). Sin cambios de código.
LLM_PROVIDER=anthropic

# ── Proveedor de EMBEDDINGS (independiente del de generación) ─
# Anthropic NO ofrece API de embeddings, así que los dos no pueden ser lo mismo.
# Valores: ollama | openai. Déjalo vacío para el comportamiento heredado, que se
# deriva de LLM_PROVIDER (openai si la generación es OpenAI; Ollama en cualquier
# otro caso, incluido anthropic). Declararlo permite, p. ej., generar con Claude y
# vectorizar con OpenAI. Un valor desconocido cae al camino heredado y avisa en el
# log: una errata aquí no da error, daría un RAG que no encuentra nada.
# EMBED_PROVIDER=

# ── Anthropic (Claude) ──────────────────────────────────────
# API key del motor por defecto. NO se versiona: inyéctala aquí o en el entorno.
# Su ausencia no aborta el arranque; la primera llamada al LLM falla (error perezoso).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Gateway/proxy opcional; vacío = endpoint oficial de Anthropic.
# ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

# ── OpenAI / compatible (Azure, vLLM, Groq, LM Studio) ──────
# Solo si LLM_PROVIDER=openai. OPENAI_BASE_URL apunta al servidor compatible.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Ollama ──────────────────────────────────────────────────
# Modelos locales (LLM_PROVIDER=ollama). OLLAMA_EMBED_MODEL es además el modelo de
# EMBEDDINGS por defecto del RAG: Anthropic NO ofrece API de embeddings. Qué
# proveedor los produce lo decide EMBED_PROVIDER (arriba), independiente del motor
# de generación (SPEC-023/AC6, #265).
#
# La DIMENSIÓN del índice la deriva el backend del modelo de embeddings activo
# (nomic-embed-text 768, text-embedding-3-small 1536, …), no de RAG_VECTOR_SIZE:
# ese ajuste solo se usa para modelos que el backend no conoce. Cambiar de modelo
# de embeddings **obliga a recrear la colección y reindexar**: los vectores de dos
# modelos distintos no son comparables.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Qdrant ──────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
# REQUIRED. Qdrant enforces this key and the backend must send it.
# Generate with: openssl rand -hex 32
QDRANT_API_KEY=

# ── MinIO ───────────────────────────────────────────────────
# REQUIRED if MinIO is enabled. Do NOT use minioadmin/minioadmin.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_URL=http://minio:9000

# ── App ─────────────────────────────────────────────────────
DEBUG=false
APP_NAME=Alejandría Magazine
